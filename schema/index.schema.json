{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://manang.invalid/schema/registry-index.schema.json",
  "title": "Manang registry index.json, schema 1 (FROZEN)",
  "type": "object",
  "required": ["schema", "generated", "plugins"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": 1 },
    "generated": { "type": "string", "format": "date-time" },
    "plugins": {
      "type": "array",
      "items": { "$ref": "#/definitions/plugin" }
    }
  },
  "definitions": {
    "relpath": {
      "description": "A path under the registry base URL: no scheme, no leading slash, no dot segments.",
      "type": "string",
      "pattern": "^(?!/)(?!.*(^|/)\\.\\.?(/|$))[A-Za-z0-9._/+-]+$",
      "maxLength": 200
    },
    "permissions": {
      "description": "Exactly the manifest's [permissions] table. Empty arrays are omitted.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "filesystem": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        },
        "network": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        },
        "buffer": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        }
      }
    },
    "version": {
      "type": "object",
      "required": [
        "version",
        "published",
        "download",
        "source",
        "size",
        "sha256",
        "permissions",
        "changelog"
      ],
      "additionalProperties": false,
      "properties": {
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
        },
        "published": { "type": "string", "format": "date-time" },
        "min_app": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
        },
        "download": { "$ref": "#/definitions/relpath" },
        "source": { "type": "string", "format": "uri", "pattern": "^https://" },
        "size": { "type": "integer", "minimum": 1 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "permissions": { "$ref": "#/definitions/permissions" },
        "changelog": { "type": "string", "maxLength": 4000 }
      }
    },
    "plugin": {
      "type": "object",
      "required": [
        "id",
        "name",
        "author",
        "description",
        "repo",
        "license",
        "tags",
        "tier",
        "latest",
        "versions"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$",
          "maxLength": 48
        },
        "name": { "type": "string", "minLength": 1, "maxLength": 80 },
        "author": { "type": "string", "minLength": 1, "maxLength": 120 },
        "description": { "type": "string", "maxLength": 500 },
        "repo": {
          "type": "string",
          "pattern": "^https://github\\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
        },
        "homepage": { "type": "string", "format": "uri", "pattern": "^https?://" },
        "license": { "type": "string", "minLength": 1, "maxLength": 120 },
        "tags": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true,
          "maxItems": 8
        },
        "tier": { "const": "wasm" },
        "readme": { "$ref": "#/definitions/relpath" },
        "latest": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
        },
        "versions": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/version" }
        },
        "yanked": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
          },
          "uniqueItems": true
        }
      }
    }
  }
}
